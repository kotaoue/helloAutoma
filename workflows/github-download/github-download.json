          "context": "website",
          "everyNewTab": false,
          "timeout": 30000,
          "preloadScripts": [],
          "code": "(async function () {\n  function next(data) {\n    automaNextBlock({ data: data });\n  }\n\n  function fail(message) {\n    alert('[Automa Download] ' + message);\n    next('Error: ' + message);\n  }\n\n  if (!location.href.match(/^https:\\/\\/github\\.com\\/[^/]+\\/[^/]+\\/blob\\//)) {\n    fail(\n      'GitHubのファイルページで実行してください。\\n\\n' +\n      '例: https://github.com/kotaoue/helloAutoma/blob/<branch>/workflows/<name>.json'\n    );\n    return;\n  }\n\n  var rawUrl = location.href.replace('/blob/', '/raw/').replace(/[?#].*$/, '');\n  var filename = decodeURIComponent(rawUrl.split('/').pop() || 'workflow.json');\n\n  try {\n    var response = await fetch(rawUrl, { credentials: 'same-origin' });\n    if (!response.ok) {\n      throw new Error('HTTP ' + response.status);\n    }\n\n    var blob = await response.blob();\n    var objectUrl = URL.createObjectURL(blob);\n    var link = document.createElement('a');\n\n    link.href = objectUrl;\n    link.download = filename;\n    document.body.appendChild(link);\n    link.click();\n    link.remove();\n    setTimeout(function () {\n      URL.revokeObjectURL(objectUrl);\n    }, 1000);\n\n    next('Downloaded JSON file: ' + filename);\n  } catch (error) {\n    fail('JSONのダウンロードに失敗しました: ' + error.message);\n  }\n})()"
        }
