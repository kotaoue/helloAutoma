          "description": "GitHubの raw JSON URLからファイルをダウンロード",
          "context": "website",
          "everyNewTab": false,
          "timeout": 30000,
          "preloadScripts": [],
          "code": "(function () {\n  function next(data) {\n    automaNextBlock({ data: data });\n  }\n\n  if (!location.href.match(/^https:\\/\\/github\\.com\\/[^/]+\\/[^/]+\\/blob\\//)) {\n    alert(\n      '[Automa Download] GitHubのファイルページで実行してください。\\n\\n' +\n      '例: https://github.com/kotaoue/helloAutoma/blob/<branch>/workflows/<name>.json'\n    );\n    next('Error: not a GitHub blob page');\n    return;\n  }\n\n  var controls = Array.prototype.slice.call(document.querySelectorAll('a, button'));\n  var downloadRawControl = controls.find(function (el) {\n    var label = [\n      el.getAttribute('aria-label'),\n      el.getAttribute('title'),\n      el.textContent\n    ].filter(Boolean).join(' ').toLowerCase();\n\n    return label.indexOf('download raw file') !== -1;\n  });\n\n  if (downloadRawControl) {\n    downloadRawControl.click();\n    next('Downloaded JSON file.');\n    return;\n  }\n\n  var rawUrl = location.href.replace('/blob/', '/raw/').replace(/[?#].*$/, '');\n  var filename = rawUrl.split('/').pop() || 'workflow.json';\n  var link = document.createElement('a');\n\n  link.href = rawUrl;\n  link.download = filename;\n  document.body.appendChild(link);\n  link.click();\n  link.remove();\n  next('Downloaded JSON file from raw URL.');\n})()"
        }
